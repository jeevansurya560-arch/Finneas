{
  "name": "finneas",
  "version": "0.0.1",
  "private": true,
  "description": "Finneas — private real-time collaborative study rooms",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@finneas/api",
    "dev:api": "npm run dev --workspace=@finneas/api",
    "dev:web": "npm run dev --workspace=@finneas/web",
    "build:api": "npm run build --workspace=@finneas/api",
    "build:web": "npm run build --workspace=@finneas/web",
    "lint": "echo \"Linting to be configured per workspace\"",
    "test": "echo \"Tests to be configured per workspace\""
  }
}
