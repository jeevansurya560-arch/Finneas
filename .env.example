# ────────────────────────────────────────────────
# Finneas — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────

# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/finneas

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Client ────────────────────────────────────────
# URL of the frontend (used for CORS in production)
CLIENT_URL=http://localhost:5173
